# Copy this file to `.env` (same folder) and fill in your values. `.env` is gitignored: never commit it.
# Without a .env file, the app uses the local SQLite file planner.db.

# Supabase → your project → Connect → "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

# Where the React app runs. Only this address may call the API (CORS).
FRONTEND_ORIGIN=http://localhost:5173
